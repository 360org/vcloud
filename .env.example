# VCloud environment configuration
# Copy to `--dart-define=...` flags when running or building.
#
# Examples for dev:
#   flutter run \
#     --dart-define=VCLOUD_ODOO_API_BASE_URL=https://odoo.example.com \
#     --dart-define=VCLOUD_ODOO_DB=production_db
#
# Never commit Odoo passwords, JWTs, or production-only hostnames.

VCLOUD_ODOO_API_BASE_URL=https://odoo.example.com
VCLOUD_ODOO_DB=production_db
