<mxfile host="app.diagrams.net" modified="2026-09-14T16:30:00.000Z" agent="AIaC 3.0" version="21.0.0" type="device">
  <diagram id="workflow-user-sync" name="VCloud Zero-Touch Automation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#F8FAFC" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TIÊU ĐỀ HỆ THỐNG -->
        <mxCell id="title" value="SƠ ĐỒ TỰ ĐỘNG HÓA VCLOUD: TẠO USER TRÊN TENANT ➔ ĐĂNG NHẬP MOBILE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Cơ chế Zero-Settings (Tự động đồng bộ Webhook) &amp; Zero-Knowledge (Định tuyến mật khẩu an toàn)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="700" height="20" as="geometry" />
        </mxCell>

        <!-- KHUNG PHÂN VÙNG GIAI ĐOẠN 1 -->
        <mxCell id="zone1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1120" height="310" as="geometry" />
        </mxCell>
        <mxCell id="zone1_tag" value="GIAI ĐOẠN 1: TẠO TÀI KHOẢN TRÊN ODOO KHÁCH HÀNG (TỰ ĐỘNG 100%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0077CD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="580" height="32" as="geometry" />
        </mxCell>

        <!-- BƯỚC 1: ADMIN TẠO USER -->
        <mxCell id="step1" value="👤 ADMIN KHÁCH HÀNG&#xa;&#xa;Vào Odoo Web (vd: ndsgroup.vn)&#xa;Tạo User (Internal / Portal)&#xa;Đặt Email &amp; Mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;fontSize=12;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="165" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- BƯỚC 2: TENANT ODOO POSTCOMMIT HOOK -->
        <mxCell id="step2" value="🏢 TENANT ODOO (res.users)&#xa;&#xa;1. Hook bắt sự kiện create/write&#xa;2. DB Commit an toàn 100%&#xa;3. Giao diện Web lưu 0ms delay!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E293B;fontSize=12;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="165" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- BƯỚC 3: THREAD NỀN BẮN WEBHOOK -->
        <mxCell id="step3" value="⚡ LUỒNG NỀN (DAEMON THREAD)&#xa;&#xa;Gửi Webhook sang Master:&#xa;POST /api/v1/mobile/master/sync-tenant-user&#xa;Bearer: Cluster Secret (Mặc định)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="165" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- BƯỚC 4: MASTER GHI NHẬN DANH BẠ -->
        <mxCell id="step4" value="🌐 MASTER HUB (vuahethong.net)&#xa;&#xa;1. Khớp [project.project] (URL Tenant)&#xa;2. Ghi nhận vào [databases.user]&#xa;➔ Trả về HTTP 200 OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#00CE2C;fontColor=#065F46;fontSize=12;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="165" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- GHI CHÚ GIAI ĐOẠN 1 -->
        <mxCell id="note1" value="✅ HOÀN TOÀN TỰ ĐỘNG: Admin không cần cấu hình Token hay URL Master. User tạo xong là Master nhận diện ngay." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#475569;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="285" width="1060" height="35" as="geometry" />
        </mxCell>

        <!-- ARROWS GIAI ĐOẠN 1 -->
        <mxCell id="a1" value="Lưu Form" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Non-blocking" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2;fontColor=#B45309;fontSize=11;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Tự động Sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00CE2C;strokeWidth=2;fontColor=#047857;fontSize=11;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- KHUNG PHÂN VÙNG GIAI ĐOẠN 2 -->
        <mxCell id="zone2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=2;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1120" height="370" as="geometry" />
        </mxCell>
        <mxCell id="zone2_tag" value="GIAI ĐOẠN 2: NGƯỜI DÙNG MỞ APP MOBILE &amp; ĐĂNG NHẬP 1 CHẠM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00CE2C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="530" height="32" as="geometry" />
        </mxCell>

        <!-- BƯỚC 5: NGƯỜI DÙNG NHẬP APP -->
        <mxCell id="step5" value="📱 VCLOUD MOBILE APP&#xa;&#xa;User nhập Email + Mật khẩu&#xa;(KHÔNG CẦN CHỌN DATABASE)&#xa;Bấm nút &quot;Đăng nhập&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;fontSize=12;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- BƯỚC 6: MASTER TRA CỨU DB -->
        <mxCell id="step6" value="🌐 MASTER HUB (vuahethong.net)&#xa;&#xa;1. Nhận POST /api/v1/auth/lookup-db&#xa;2. Tra cứu [databases.user]&#xa;3. Tìm thấy DB ứng viên: &quot;nds&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0077CD;fontColor=#1E293B;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="520" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- BƯỚC 7: XÁC THỰC MẬT KHẨU CHÉO -->
        <mxCell id="step7" value="🛡️ XÁC THỰC ZERO-KNOWLEDGE&#xa;&#xa;Master gọi sang Tenant Odoo:&#xa;JSON-RPC: common.authenticate()&#xa;Đúng Mật khẩu ➔ Trả về URL Tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="520" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- BƯỚC 8: ĐĂNG NHẬP THÀNH CÔNG -->
        <mxCell id="step8" value="🎉 ĐĂNG NHẬP THÀNH CÔNG!&#xa;&#xa;App Mobile nhận JWT từ Tenant:&#xa;• Internal: Mở Chấm công, Chat, Dự án&#xa;• Portal: Mở Kênh Vé &amp; Tin nhắn hỗ trợ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#00CE2C;fontColor=#065F46;fontSize=12;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="520" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- GHI CHÚ GIAI ĐOẠN 2 -->
        <mxCell id="note2" value="🔒 BẢO MẬT TUYỆT ĐỐI: Master chỉ trả về thông tin DB khi mật khẩu chính xác (Chống dò quét thông tin khách hàng). Người dùng đăng nhập trong &lt; 1 giây." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#475569;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="650" width="1060" height="35" as="geometry" />
        </mxCell>

        <!-- ARROWS GIAI ĐOẠN 2 -->
        <mxCell id="a4" value="Gửi Login + Pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0077CD;strokeWidth=2;fontColor=#0077CD;fontSize=11;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Xác thực chéo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2;fontColor=#B45309;fontSize=11;" edge="1" parent="1" source="step6" target="step7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Khớp Mật khẩu ➔ Login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00CE2C;strokeWidth=2;fontColor=#047857;fontSize=11;" edge="1" parent="1" source="step7" target="step8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ARROW KẾT NỐI TỪ GIAI ĐOẠN 1 XUỐNG GIAI ĐOẠN 2 -->
        <mxCell id="a_sync_to_login" value="Danh bạ đã sẵn sàng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#475569;fontSize=11;" edge="1" parent="1" source="step4" target="step6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="420" />
              <mxPoint x="450" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>