# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# VCloud - Flutter Web build, served via nginx.
# Build:  docker compose -f docker-compose.web.yml up --build
# Open:   http://localhost:8080
#
# Odoo API settings fall back to defaults in lib/core/config/env.dart.
# Override at build time with:
#   --build-arg ODOO_API_BASE_URL=... --build-arg ODOO_DB=...
# ---------------------------------------------------------------------------

FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /app
COPY . .

# Public images may lag the local Dart patch version. Relax only inside the
# container; never change the host pubspec constraint.
RUN sed -i "s/\^3\.12\.2/'>=3.12.0 <4.0.0'/" pubspec.yaml \
 && rm -f pubspec.lock \
 && flutter pub get

ARG ODOO_API_BASE_URL=""
ARG ODOO_DB=""
RUN flutter build web --release \
      $( [ -n "$ODOO_API_BASE_URL" ] && echo --dart-define=VCLOUD_ODOO_API_BASE_URL=$ODOO_API_BASE_URL ) \
      $( [ -n "$ODOO_DB" ] && echo --dart-define=VCLOUD_ODOO_DB=$ODOO_DB )

FROM nginx:alpine AS serve
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
