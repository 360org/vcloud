# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# VCloud — Flutter Web build, served via nginx.
# Build:  docker compose -f docker-compose.web.yml up --build
# Open:   http://localhost:8080
#
# Supabase URL/anon-key fall back to the defaults baked into
# lib/core/config/env.dart. Override at build time with:
#   --build-arg SUPABASE_URL=... --build-arg SUPABASE_ANON_KEY=...
# ---------------------------------------------------------------------------

# ---- build stage ----------------------------------------------------------
FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /app
COPY . .

# The published cirruslabs/flutter:stable image ships Dart 3.12.0, but this
# project declares ^3.12.2 (built on a newer local Flutter than any public
# image yet ships). The gap is a single patch release with no APIs this app
# uses, so relax the SDK floor *inside the build only* — the host's pubspec
# files are never modified — keeping every pinned package version intact.
RUN sed -i "s/\^3\.12\.2/'>=3.12.0 <4.0.0'/" pubspec.yaml \
 && rm -f pubspec.lock \
 && flutter pub get

ARG SUPABASE_URL=""
ARG SUPABASE_ANON_KEY=""
RUN flutter build web --release \
      $( [ -n "$SUPABASE_URL" ] && echo --dart-define=VCLOUD_SUPABASE_URL=$SUPABASE_URL ) \
      $( [ -n "$SUPABASE_ANON_KEY" ] && echo --dart-define=VCLOUD_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY )

# ---- serve stage ----------------------------------------------------------
FROM nginx:alpine AS serve
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
